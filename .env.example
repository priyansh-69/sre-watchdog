# ==========================================
# Agentic-SRE Environment Variables
# ==========================================

# 1. AI Provider Configuration
# Which AI engine should the middleware use? (gemini, groq, openai, ollama)
AGENTIC_AI_PROVIDER="gemini"

# Google Gemini API Key (Get from Google AI Studio)
GEMINI_API_KEY="your_google_ai_studio_key_here"

# 2. Notification Dispatcher
# Where should the AI send the crash reports?
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR/WEBHOOK/URL"

# 3. Security & Privacy
# Should local environment variables from the crashing server be sent to the AI? 
# Default is False to prevent accidental secrets leakage.
AGENTIC_SEND_ENV_VARS="False"